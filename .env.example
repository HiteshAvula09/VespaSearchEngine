DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

SLACK_SCHEMA=slack
DRIVE_SCHEMA=google_drive
GITHUB_SCHEMA=github

SLACK_TABLES=channel_messages,threads,channels,users,channel_members
DRIVE_TABLE=documents
GITHUB_TABLES=issues,issue_comments,pull_requests,pull_request_comments,commits,repositories

VESPA_URL=http://localhost:8080
VESPA_CONFIG_URL=http://localhost:19071
VESPA_NAMESPACE=vespasearch
VESPA_SCHEMA=enterprise
VESPA_CONTENT_CLUSTER=content

CHUNK_SIZE=1400
CHUNK_OVERLAP=180

LLM_PROVIDER=groq
LLM_ENABLED=true

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_URL=https://api.groq.com/openai/v1

TOP_K=5
DEFAULT_SEARCH_MODE=hybrid

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
