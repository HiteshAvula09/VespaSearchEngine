<?xml version="1.0" encoding="utf-8" ?>
<!--
Optional Phase 2 example.

Vespa can run llama.cpp-compatible GGUF models using LocalLLM and can use
RAGSearcher for retrieval-augmented generation. This file is not enabled
by default because LocalLLM is currently documented as beta and requires
significantly more Docker memory.

Replace YOUR_GGUF_MODEL_URL before experimenting.
-->
<services version="1.0">
    <container id="default" version="1.0">
        <search>
            <chain id="rag" inherits="vespa">
                <searcher id="ai.vespa.search.llm.RAGSearcher">
                    <config name="ai.vespa.search.llm.llm-searcher">
                        <providerId>local</providerId>
                    </config>
                </searcher>
            </chain>
        </search>

        <document-processing />
        <document-api />

        <component id="arctic" type="hugging-face-embedder">
            <transformer-model url="https://huggingface.co/Snowflake/snowflake-arctic-embed-xs/resolve/main/onnx/model_quantized.onnx"/>
            <tokenizer-model url="https://huggingface.co/Snowflake/snowflake-arctic-embed-xs/raw/main/tokenizer.json"/>
            <pooling-strategy>cls</pooling-strategy>
            <normalize>true</normalize>
            <max-tokens>512</max-tokens>
            <prepend>
                <query>Represent this sentence for searching relevant passages: </query>
            </prepend>
        </component>

        <component id="local" class="ai.vespa.llm.clients.LocalLLM">
            <config name="ai.vespa.llm.clients.llm-local-client">
                <model url="YOUR_GGUF_MODEL_URL" />
                <contextSize>4096</contextSize>
                <parallelRequests>1</parallelRequests>
                <useGpu>false</useGpu>
            </config>
        </component>
    </container>

    <content id="content" version="1.0">
        <min-redundancy>1</min-redundancy>
        <documents>
            <document type="enterprise" mode="index" />
        </documents>
    </content>
</services>
