schema enterprise {

    document enterprise {
        field doc_id type string {
            indexing: attribute | summary
            match: word
        }

        field parent_id type string {
            indexing: attribute | summary
            match: word
        }

        field chunk_id type string {
            indexing: attribute | summary
            match: word
        }

        field source type string {
            indexing: attribute | summary
            match: word
        }

        field source_type type string {
            indexing: attribute | summary
            match: word
        }

        field title type string {
            indexing: index | summary
            match: text
            index: enable-bm25
        }

        field content type string {
            indexing: index | summary
            match: text
            index: enable-bm25
        }

        field author type string {
            indexing: attribute | summary
        }

        field url type string {
            indexing: summary
        }

        field updated_at type long {
            indexing: attribute | summary
        }

        field metadata_json type string {
            indexing: summary
        }
    }

    fieldset default {
        fields: title, content
    }

    field embedding type tensor<bfloat16>(v[384]) {
        indexing: input title . " " . input content | embed arctic | index | attribute
        attribute {
            distance-metric: angular
        }
        index {
            hnsw {
                max-links-per-node: 16
                neighbors-to-explore-at-insert: 200
            }
        }
    }

    rank-profile bm25 {
        first-phase {
            expression: bm25(title) + bm25(content)
        }
        match-features: bm25(title) bm25(content)
    }

    rank-profile semantic {
        inputs {
            query(e) tensor<bfloat16>(v[384])
        }
        first-phase {
            expression: closeness(field, embedding)
        }
        match-features: closeness(field, embedding)
    }

    rank-profile hybrid {
        inputs {
            query(e) tensor<bfloat16>(v[384])
        }

        function bm25_score() {
            expression: bm25(title) + bm25(content)
        }

        function normalized_bm25() {
            expression: 2 * atan(bm25_score / 8) / 3.14159
        }

        function cosine() {
            expression: cos(distance(field, embedding))
        }

        first-phase {
            expression: normalized_bm25 + cosine
        }

        match-features {
            bm25(title)
            bm25(content)
            bm25_score
            normalized_bm25
            cosine
            closeness(field, embedding)
        }
    }
}
